# =============================================================================
# 1. SUPABASE — Dashboard -> Project Settings -> API Keys
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Dùng MỘT trong hai (code tự nhận cả hai tên biến):
#
#  (a) Publishable key — ĐỊNH DẠNG MỚI, nên dùng cho project mới.
#      Supabase sẽ khai tử anon/service_role JWT vào cuối 2026.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
#
#  (b) Legacy anon key (JWT `eyJ...`) — vẫn chạy, dành cho project cũ.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Cả hai key trên đều map tới Postgres role `anon`, nên RLS + GRANT trong
# migration áp dụng y hệt nhau. Chúng LỘ RA PHÍA CLIENT theo thiết kế —
# an toàn vì `anon` chỉ có quyền SELECT trên `codes` và EXECUTE hai hàm
# submit_code() / report_code().


# =============================================================================
# 2. TRANG QUẢN TRỊ (/admin) — BẮT BUỘC nếu muốn dùng trang admin
# =============================================================================

# Secret key (hoặc service_role key legacy). Trang admin cần key này để gọi
# các hàm admin_* — những hàm đã revoke khỏi anon.
# ⚠️ KHÔNG prefix NEXT_PUBLIC_. Lộ key này = mất toàn quyền database.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # tên cũ, vẫn dùng được

# Mật khẩu đăng nhập /admin. Đặt dài và ngẫu nhiên — đây là thứ duy nhất
# đứng giữa internet và quyền sửa dữ liệu.
#   Tạo bằng: openssl rand -base64 24
ADMIN_PASSWORD=doi-mat-khau-nay-ngay

# Khoá ký cookie phiên admin (HMAC-SHA256). Tối thiểu 32 ký tự.
#   Tạo bằng: openssl rand -hex 32
# Đổi giá trị này = đăng xuất toàn bộ phiên admin đang mở.
ADMIN_SESSION_SECRET=thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu
